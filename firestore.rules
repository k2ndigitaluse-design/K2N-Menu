rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow public read access to all menu categories per floor
    // Allow write access ONLY to the verified restaurant owner UID
    match /menus/{floorId}/categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == "OWNER_UID_HERE";
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
